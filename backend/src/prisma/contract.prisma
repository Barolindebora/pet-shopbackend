// use prisma-8

enum UnidadStock {
  @@type("pg/text@1")

  UNIDAD
  KILOGRAMO
}

enum TipoMovimiento {
  @@type("pg/text@1")

  ENTRADA
  SALIDA
}

model Proveedor {
  id           Int                @id @default(autoincrement())
  nombre       String
  telefono     String?
  email        String?
  activo       Boolean            @default(true)

  productos    Producto[]
  movimientos  MovimientoStock[]
  reposiciones ListaReposicion[]
}

model Marca {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  activo    Boolean   @default(true)

  productos Producto[]
}

model Categoria {
  id        Int                 @id @default(autoincrement())
  nombre    String              @unique
  activo    Boolean             @default(true)

  productos ProductoCategoria[]
}

model Producto {
  id             Int          @id @default(autoincrement())
  nombre         String
  descripcion    String?
  codigoBarra    String?      @unique
  presentacion   String?
  unidadStock    UnidadStock

  stockActual    Decimal      
  stockMinimo    Decimal      

  costoCompra    Decimal
  precioSugerido Decimal?
  precioEfectivo Decimal
  precioTarjeta  Decimal

  activo         Boolean      @default(true)

  proveedorId    Int
  proveedor      Proveedor    @relation(fields: [proveedorId], references: [id])

  marcaId        Int
  marca          Marca        @relation(fields: [marcaId], references: [id])

  categorias     ProductoCategoria[]
  movimientos    MovimientoStock[]
  reposiciones   ListaReposicion[]
}

model ProductoCategoria {
  productoId  Int
  categoriaId Int

  producto    Producto  @relation(fields: [productoId], references: [id])
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  @@id([productoId, categoriaId])
}

model MovimientoStock {
  id           Int             @id @default(autoincrement())
  tipo         TipoMovimiento
  cantidad     Decimal
  fecha        DateTime        @default(now())
  costoCompra  Decimal?
  observacion  String?

  productoId   Int
  producto     Producto        @relation(fields: [productoId], references: [id])

  proveedorId  Int?
  proveedor    Proveedor?      @relation(fields: [proveedorId], references: [id])
}

model ListaReposicion {
  id                Int       @id @default(autoincrement())
  cantidadAReponer  Decimal?
  fechaCreacion     DateTime  @default(now())

  productoId        Int
  producto          Producto  @relation(fields: [productoId], references: [id])

  proveedorId       Int
  proveedor         Proveedor @relation(fields: [proveedorId], references: [id])
}